// Weapons: what a player holds and fires. A weapon names the projectile it
// fires and says what a shot costs (a round, or `energy`), how fast it
// cycles and how it kicks. `family` ties the light and heavy versions of a
// weapon together: changing armor swaps a carried weapon for the new armor's
// weapon of the same family (grenade launcher and mortar, laser and railgun).
// `muzzle` is where its model's barrel ends as first person draws it, so its
// rounds, beams and flash leave there.
{
  "disc": {
    "name": "Disc launcher",
    "about": "Splash damage and disc jumps.",
    "family": "disc",
    "projectile": "disc",
    "reload": 1.05,
    "shake": 0.08,
    "bot_spread": 3.2,
    "view": "disc",
    "muzzle": [-0.030, -0.013, -0.454],
    "sound": "disc",
    "loot": "roll"
  },
  // The repeater (its id stays "chaingun", which mods and maps use).
  "chaingun": {
    "name": "Repeater",
    "about": "Fast automatic rounds, some spread.",
