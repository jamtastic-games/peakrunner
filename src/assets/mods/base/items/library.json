  "ammo-box": { "name": "Ammo box", "about": "Half your rounds, two grenades.", "rounds": 0.5, "grenades": 2, "look": "box" },
  "energy-cell": { "name": "Energy cell", "about": "A full tank.", "energy": 200.0, "look": "cell" }
}
