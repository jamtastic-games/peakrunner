// Sparkfall's placed things, carried as packs (packs/sparkfall.json) mostly
// by the Rigger. Team limits grow with the team (`per_teammate`).
{
  "spring-pad": { "extends": "launch-pad", "name": "Spring pad", "team_limit": 2, "per_teammate": 0.25, "per_player": 2 },
  "boost-plate": { "extends": "accelerator-pad", "name": "Boost plate", "team_limit": 2, "per_teammate": 0.25, "per_player": 2 },
  "gate": { "extends": "teleporter", "name": "Gate", "about": "Place two: step into one, out of the other. Flag carriers can't.",
    "team_limit": 2, "per_teammate": 0.15 },
  "deck": { "extends": "platform", "name": "Deck", "team_limit": 4, "per_teammate": 0.5 },
  "zap-grate": { "extends": "shock-floor", "name": "Zap grate", "team_limit": 2, "per_teammate": 0.2,
    "shock": { "damage": 10.0, "cooldown": 0.6, "effect": "static" } },
  "mend-pylon": { "extends": "repair-pylon", "name": "Mend pylon", "aura": { "effect": "mended", "range": 10.0 } },
  "ward-pylon": { "extends": "shield-pylon", "name": "Ward pylon", "aura": { "effect": "warded", "range": 12.0 }, "team_limit": 1 },
  "veil-pylon": { "extends": "jammer-pylon", "name": "Veil pylon", "about": "Teammates within 8 m are veiled.",
    "aura": { "effect": "veiled", "range": 8.0 }, "team_limit": 1 },
  "static-pylon": { "extends": "jammer-pylon", "name": "Static pylon", "about": "Enemies within 12 m are drained.",
    "aura": { "effect": "static", "range": 12.0, "targets": "enemies" }, "team_limit": 1 },
  "hush-pylon": { "extends": "jammer-pylon", "name": "Hush pylon", "about": "Teammates within 20 m are hidden from sensors.", "team_limit": 2 },
  "eye": { "name": "Eye", "about": "A camera and a sensor: enemies within 70 m are marked.", "behavior": "post", "look": "camera",
    "hull": 70.0, "team_limit": 3, "per_teammate": 0.25, "camera": true, "sensor": { "range": 70.0 } },
  "tripwire": { "extends": "motion-sensor", "name": "Tripwire", "about": "An alarm for movement within 12 m.", "hull": 30.0,
    "team_limit": 6, "sensor": { "range": 12.0, "moving": true, "alarm": true }, "look": "beacon", "life": 300.0 },
  "laser-sentry": { "extends": "turret", "name": "Laser sentry", "hull": 40.0, "team_limit": 4, "life": 10.0,
    "turret": { "range": 30.0, "sensed_range": 30.0, "speed": 420.0, "life": 0.3, "cooldown": 0.5, "leads": false, "fires": true,
      "projectile": "bullet" } },
  "spark-turret": { "extends": "turret", "name": "Spark turret", "about": "Electric bolts at enemies in sight, 60 m.", "team_limit": 2,
    "per_teammate": 0.25, "turret": { "range": 60.0, "sensed_range": 90.0, "speed": 160.0, "life": 2.0, "cooldown": 0.9,
      "leads": true, "fires": true, "projectile": "turret-spark" } },
  "missile-battery": { "extends": "turret", "name": "Missile battery", "about": "Guided missiles, steered from a command post.",
    "team_limit": 1, "hull": 300.0, "turret": { "range": 0.0, "sensed_range": 0.0, "speed": 45.0, "life": 10.0, "cooldown": 4.0,
      "leads": false, "fires": true, "projectile": "guided-missile" } },
  "command-post": { "extends": "command-station", "name": "Command post", "team_limit": 1 },
  "flier-bay": { "extends": "vehicle-pad", "name": "Flier bay", "about": "Stand on it to take a skiff or a transport.",
    "vehicles": ["sparkfall-skiff", "sparkfall-transport"], "team_limit": 1 }
}
